#!/usr/bin/env python3
"""Run a command with the Supabase settings from ~/.config/mellonhead/supabase.env.
Reads KEY=value lines literally (no shell parsing, so special characters in passwords are fine).
Never prints the values. Usage: scripts/with-env <command> [args...]"""
import os, sys
path = os.path.expanduser('~/.config/mellonhead/supabase.env')
env = dict(os.environ)
with open(path) as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        v = v.strip()
        if len(v) >= 2 and v[0] == v[-1] and v[0] in '\'"':
            v = v[1:-1]
        env[k.strip()] = v
if len(sys.argv) < 2:
    sys.exit('usage: with-env <command> [args...]')
os.execvpe(sys.argv[1], sys.argv[1:], env)
